# Copy to .env for local use. On Vercel, set these in Project → Settings → Environment Variables.

# Neon / Postgres connection string (required on Vercel — SQLite does not work there)
# Create via Vercel Dashboard → Storage → Create Database → Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Long random string for session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Owner password used by prisma/seed.ts (admin@mokajoy.ma)
ADMIN_PASSWORD="your-secure-password"

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
